; Textured opaque VU1 frustum-clipping microprogram.
; The EE routes only source slices whose conservative bounds intersect clip Z = 0.
; Every triangle is clipped against near, left, right, bottom, and top before reciprocal W.

		.vu
		.align 4
		.global	Ps2OpaqueTexturedClipDraw3D_CodeStart
		.global	Ps2OpaqueTexturedClipDraw3D_CodeEnd
Ps2OpaqueTexturedClipDraw3D_CodeStart:
__ps2_opaque_textured_clip_draw_3d:
         NOP                                                        xtop VI02
         NOP                                                        lq VF01, 0(VI02)
         NOP                                                        lq VF02, 1(VI02)
         NOP                                                        lq VF03, 2(VI02)
         NOP                                                        lq VF04, 3(VI02)
         NOP                                                        lq VF05, 4(VI02)
         NOP                                                        lq VF06, 5(VI02)
         NOP                                                        lq VF07, 6(VI02)
         NOP                                                        ilw.x VI01, 7(VI02)
         NOP                                                        ilw.y VI08, 7(VI02)
         NOP                                                        lq VF11, 8(VI02)
         NOP                                                        lq VF12, 9(VI02)
         NOP                                                        lq VF13, 10(VI02)
         NOP                                                        lq VF14, 12(VI02)
         NOP                                                        iaddiu VI04, VI00, 0x00000100
         NOP                                                        iaddiu VI03, VI04, 0x00000008
         NOP                                                        iaddiu VI05, VI02, 0x00000015
         NOP                                                        iaddiu VI06, VI00, 0x00000000
         NOP                                                        iaddiu VI09, VI00, 0x00007fff
         NOP                                                        iaddiu VI09, VI09, 0x00000001
         NOP                                                        lq VF08, 13(VI02)
         NOP                                                        sq VF08, 0(VI04)
         NOP                                                        lq VF08, 14(VI02)
         NOP                                                        sq VF08, 1(VI04)
         NOP                                                        lq VF08, 15(VI02)
         NOP                                                        sq VF08, 2(VI04)
         NOP                                                        lq VF08, 16(VI02)
         NOP                                                        sq VF08, 3(VI04)
         NOP                                                        lq VF08, 17(VI02)
         NOP                                                        sq VF08, 4(VI04)
         NOP                                                        lq VF08, 18(VI02)
         NOP                                                        sq VF08, 5(VI04)
         NOP                                                        lq VF08, 19(VI02)
         NOP                                                        sq VF08, 6(VI04)
         NOP                                                        lq VF08, 20(VI02)
         NOP                                                        sq VF08, 7(VI04)
texturedClipTriangleLoop:
         NOP                                                        lq VF18, 0(VI05)
         NOP                                                        lq VF19, 1(VI05)
         NOP                                                        lq VF20, 2(VI05)
         NOP                                                        lq VF21, 3(VI05)
         NOP                                                        lq VF22, 4(VI05)
         NOP                                                        lq VF23, 5(VI05)
         NOP                                                        lq VF10, 6(VI05)
         mulax         ACC, VF11, VF10x                             NOP
         madday        ACC, VF12, VF10y                             NOP
         maddz.xyz     VF15, VF13, VF10z                            NOP
         mul.xyz       VF16, VF15, VF15                             NOP
         addy.x        VF16, VF16, VF16y                            NOP
         addz.x        VF16, VF16, VF16z                            NOP
         NOP                                                        ersqrt P, VF16x
         NOP                                                        waitp
         NOP                                                        mfp.w VF16, P
         mulw.xyz      VF15, VF15, VF16w                            NOP
         mul.xyz       VF16, VF15, VF14                             NOP
         addy.x        VF16, VF16, VF16y                            NOP
         addz.x        VF16, VF16, VF16z                            NOP
         maxx.x        VF16, VF16, VF00x                            NOP
         mulw.x        VF16, VF16, VF07w                            NOP
         NOP                                                        loi 0x433f0000
         muli.x        VF16, VF16, I                                NOP
         NOP                                                        loi 0x42800000
         addi.x        VF16, VF16, I                                NOP
         mulw.w        VF17, VF00, VF10w                            NOP
         mulx.xyz      VF17, VF07, VF16x                            NOP
         ftoi0         VF17, VF17                                   NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         mulax         ACC, VF01, VF18x                             NOP
         madday        ACC, VF02, VF18y                             NOP
         maddaz        ACC, VF03, VF18z                             NOP
         maddw         VF18, VF04, VF18w                            NOP
         mulax         ACC, VF01, VF19x                             NOP
         madday        ACC, VF02, VF19y                             NOP
         maddaz        ACC, VF03, VF19z                             NOP
         maddw         VF19, VF04, VF19w                            NOP
         mulax         ACC, VF01, VF20x                             NOP
         madday        ACC, VF02, VF20y                             NOP
         maddaz        ACC, VF03, VF20z                             NOP
         maddw         VF20, VF04, VF20w                            NOP
texturedClipClassifyTriangle:
texturedClipHardwareClipFlagDiagnostics:
; Task 3 seeds homogeneous positions and raw UVs before any clipping operation. The saved
; loop/output values survive FCAND, which always writes VI01 on this assembler.
texturedClipSeedPolygon:
         NOP                                                        iadd VI10, VI01, VI00
         NOP                                                        isw.x VI10, 0x0000004e(VI00)
         NOP                                                        isw.x VI03, 0x0000004f(VI00)
         NOP                                                        iaddiu VI12, VI00, 0x00000050
         NOP                                                        iaddiu VI13, VI00, 0x00000003
         NOP                                                        sq VF18, 0(VI12)
         NOP                                                        sq VF21, 1(VI12)
         NOP                                                        sq VF19, 2(VI12)
         NOP                                                        sq VF22, 3(VI12)
         NOP                                                        sq VF20, 4(VI12)
         NOP                                                        sq VF23, 5(VI12)
         NOP                                                        b texturedClipRunPolygonPlanes
         NOP                                                        NOP

texturedClipRunPolygonPlanes:
; Ps2VuTexturedSourceLimits.hpp reserves two qwords per vertex: buffer A 0x50 and
; buffer B 0x64. Six passes can grow a triangle to at most nine vertices.
texturedClipPlaneCameraW:
; d = w - epsilon. The synthetic negative-Z CLIPW flag below means w < epsilon.
         NOP                                                        iaddiu VI09, VI00, 0x00000000
         NOP                                                        bal VI15, texturedClipPolygonAgainstPlane
         NOP                                                        NOP
         NOP                                                        ibeq VI13, VI00, texturedClipRestoreTriangleLoopTail
         NOP                                                        NOP
texturedClipPlaneNearZ:
; d = z - epsilon. The proven B296 synthetic negative-Z flag means z < epsilon.
         NOP                                                        iaddiu VI09, VI00, 0x00000001
         NOP                                                        bal VI15, texturedClipPolygonAgainstPlane
         NOP                                                        NOP
         NOP                                                        ibeq VI13, VI00, texturedClipRestoreTriangleLoopTail
         NOP                                                        NOP
texturedClipPlaneLeft:
; d = x + w.
         NOP                                                        iaddiu VI09, VI00, 0x00000002
         NOP                                                        bal VI15, texturedClipPolygonAgainstPlane
         NOP                                                        NOP
         NOP                                                        ibeq VI13, VI00, texturedClipRestoreTriangleLoopTail
         NOP                                                        NOP
texturedClipPlaneRight:
; d = w - x.
         NOP                                                        iaddiu VI09, VI00, 0x00000003
         NOP                                                        bal VI15, texturedClipPolygonAgainstPlane
         NOP                                                        NOP
         NOP                                                        ibeq VI13, VI00, texturedClipRestoreTriangleLoopTail
         NOP                                                        NOP
texturedClipPlaneBottom:
; d = y + w.
         NOP                                                        iaddiu VI09, VI00, 0x00000004
         NOP                                                        bal VI15, texturedClipPolygonAgainstPlane
         NOP                                                        NOP
         NOP                                                        ibeq VI13, VI00, texturedClipRestoreTriangleLoopTail
         NOP                                                        NOP
texturedClipPlaneTop:
; d = w - y.
         NOP                                                        iaddiu VI09, VI00, 0x00000005
         NOP                                                        bal VI15, texturedClipPolygonAgainstPlane
         NOP                                                        NOP
         NOP                                                        b texturedClipTriangulatePolygon
         NOP                                                        NOP

; Task 4 owns fan expansion, perspective division, winding rejection, and GIF compaction.
texturedClipTriangulatePolygon:
         NOP                                                        ilw.x VI03, 0x0000004f(VI00)
         NOP                                                        iaddiu VI14, VI00, 0x00000003
         NOP                                                        isub VI14, VI13, VI14
         NOP                                                        ibltz VI14, texturedClipRestoreTriangleLoopTail
         NOP                                                        NOP
         NOP                                                        lq VF18, 0(VI12)
         NOP                                                        lq VF21, 1(VI12)
         NOP                                                        iaddiu VI10, VI12, 0x00000002
         NOP                                                        isubiu VI14, VI13, 0x00000002
texturedClipEmitTriangleFanLoop:
         NOP                                                        lq VF19, 0(VI10)
         NOP                                                        lq VF22, 1(VI10)
         NOP                                                        lq VF20, 2(VI10)
         NOP                                                        lq VF23, 3(VI10)
         NOP                                                        bal VI15, texturedClipEmitTriangle
         NOP                                                        NOP
         NOP                                                        iaddiu VI10, VI10, 0x00000002
         NOP                                                        isubiu VI14, VI14, 0x00000001
         NOP                                                        ibne VI14, VI00, texturedClipEmitTriangleFanLoop
         NOP                                                        NOP
texturedClipEmitTriangleFanComplete:
         NOP                                                        ilw.x VI01, 0x0000004e(VI00)
         NOP                                                        NOP
         NOP                                                        b texturedClipTriangleLoopTail
         NOP                                                        NOP
texturedClipRestoreTriangleLoopTail:
         NOP                                                        ilw.x VI01, 0x0000004e(VI00)
         NOP                                                        ilw.x VI03, 0x0000004f(VI00)

texturedClipTriangleLoopTail:
         NOP                                                        iaddiu VI05, VI05, 0x00000007
         NOP                                                        isubiu VI01, VI01, 0x00000001
         NOP                                                        ibne VI01, VI00, texturedClipTriangleLoop
         NOP                                                        NOP
texturedClipRestoreGifTagEndFlag:
         NOP                                                        ibeq VI06, VI00, texturedClipNoOutput
         NOP                                                        NOP
         NOP                                                        iaddiu VI09, VI00, 0x00007fff
         NOP                                                        iaddiu VI09, VI09, 0x00000001
         NOP                                                        iadd VI07, VI06, VI06
         NOP                                                        iadd VI07, VI07, VI06
         NOP                                                        iadd VI07, VI07, VI09
         NOP                                                        isw.x VI07, 7(VI04)
         NOP                                                        xgkick VI04
         NOP[E]                                                     NOP
texturedClipNoOutput:
         NOP[E]                                                     NOP
         NOP                                                        NOP

; Interpolates one previous/current polygon edge. VF24/VF25 are the matching signed
; distances. The same clamped t is applied to homogeneous XYZW and raw UV.
texturedClipIntersectEdge:
         NOP                                                        iaddiu VI03, VI00, 0x00000000
         sub.x         VF27, VF24, VF25                             NOP
         abs.x         VF26, VF27                                   NOP
         NOP                                                        loi 0x3727c5ac
         subi.x        VF26, VF26, I                                NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000080
         NOP                                                        fmand VI03, VI03
         NOP                                                        ibne VI03, VI00, texturedClipIntersectEdgeReturn
         NOP                                                        NOP
         mulw.xyzw     VF28, VF18, VF00w                            NOP
         mulw.xyzw     VF29, VF19, VF00w                            NOP
         mulw.xyzw     VF30, VF21, VF00w                            NOP
         mulw.xyzw     VF31, VF22, VF00w                            NOP
         sub.xyzw      VF29, VF29, VF28                             NOP
         sub.xy        VF31, VF31, VF30                             NOP
         NOP                                                        div Q, VF24x, VF27x
         NOP                                                        waitq
         mulq.w        VF26, VF00, Q                                NOP
         maxw.x        VF26, VF00, VF26w                            NOP
         miniw.x       VF26, VF26, VF00w                            NOP
         mulx.xyzw     VF29, VF29, VF26x                            NOP
         mulx.xy       VF31, VF31, VF26x                            NOP
         add.xyzw      VF28, VF28, VF29                             NOP
         add.xy        VF30, VF30, VF31                             NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000000
         NOP                                                        ibeq VI09, VI03, texturedClipSnapCameraW
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000001
         NOP                                                        ibeq VI09, VI03, texturedClipSnapNearZ
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000002
         NOP                                                        ibeq VI09, VI03, texturedClipSnapLeft
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000003
         NOP                                                        ibeq VI09, VI03, texturedClipSnapRight
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000004
         NOP                                                        ibeq VI09, VI03, texturedClipSnapBottom
         NOP                                                        NOP
         NOP                                                        b texturedClipSnapTop
         NOP                                                        NOP
texturedClipSnapCameraW:
         subw.w        VF28, VF00, VF00w                            loi 0x3727c5ac
         NOP                                                        NOP
         NOP                                                        NOP
         addi.w        VF28, VF28, I                                NOP
         NOP                                                        b texturedClipIntersectEdgeEmit
         NOP                                                        NOP
texturedClipSnapNearZ:
         NOP                                                        loi 0x3727c5ac
         addi.z        VF28, VF00, I                                NOP
         NOP                                                        b texturedClipIntersectEdgeEmit
         NOP                                                        NOP
texturedClipSnapLeft:
         subw.x        VF28, VF00, VF28w                            NOP
         NOP                                                        b texturedClipIntersectEdgeEmit
         NOP                                                        NOP
texturedClipSnapRight:
         addw.x        VF28, VF00, VF28w                            NOP
         NOP                                                        b texturedClipIntersectEdgeEmit
         NOP                                                        NOP
texturedClipSnapBottom:
         subw.y        VF28, VF00, VF28w                            NOP
         NOP                                                        b texturedClipIntersectEdgeEmit
         NOP                                                        NOP
texturedClipSnapTop:
         addw.y        VF28, VF00, VF28w                            NOP
texturedClipIntersectEdgeEmit:
         NOP                                                        iaddiu VI03, VI00, 0x00000001
texturedClipIntersectEdgeReturn:
         NOP                                                        jr VI15
         NOP                                                        NOP

; Clips VI12/VI13 against VI09's camera, near, and homogeneous side planes. CLIPW's
; low six flags are x+, x-, y+, y-, z+, z-; a zero FCAND result is inside. Camera-W
; and near-Z encode their epsilon tests in synthetic Z so the z- flag stays authoritative.
; FCAND writes VI01, therefore the outer loop counter/output pointer are saved before entry
; and every live cursor/count remains in VI07-VI14 while flags are captured immediately.
; Source triangle input occupies qwords 0x15..0x4c: eight seven-qword records end at 0x4c.
; VI04 temporarily retains the ping-pong output base and is restored to GIF output 0x100 on
; every return. VI08 remains the material double-sided flag; 0x4e.y is only current membership.
texturedClipPolygonAgainstPlane:
         NOP                                                        iadd VI02, VI15, VI00
         NOP                                                        iaddiu VI03, VI00, 0x00000050
         NOP                                                        ibeq VI12, VI03, texturedClipPolygonUseBufferB
         NOP                                                        NOP
         NOP                                                        iaddiu VI04, VI00, 0x00000050
         NOP                                                        b texturedClipPolygonOutputReady
         NOP                                                        NOP
texturedClipPolygonUseBufferB:
         NOP                                                        iaddiu VI04, VI00, 0x00000064
texturedClipPolygonOutputReady:
; VI10 advances for every emitted qword pair; VI04 retains the selected output buffer base.
         NOP                                                        iadd VI10, VI04, VI00
         NOP                                                        iaddiu VI11, VI00, 0x00000000
         NOP                                                        iadd VI07, VI13, VI13
         NOP                                                        isubiu VI07, VI07, 0x00000002
         NOP                                                        iadd VI07, VI07, VI12
         NOP                                                        lq VF18, 0(VI07)
         NOP                                                        lq VF21, 1(VI07)
         NOP                                                        iaddiu VI03, VI00, 0x00000000
         NOP                                                        ibeq VI09, VI03, texturedClipClassifyPreviousCameraW
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000001
         NOP                                                        ibeq VI09, VI03, texturedClipClassifyPreviousNearZ
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000002
         NOP                                                        ibeq VI09, VI03, texturedClipClassifyPreviousLeft
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000003
         NOP                                                        ibeq VI09, VI03, texturedClipClassifyPreviousRight
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000004
         NOP                                                        ibeq VI09, VI03, texturedClipClassifyPreviousBottom
         NOP                                                        NOP
         NOP                                                        b texturedClipClassifyPreviousTop
         NOP                                                        NOP
texturedClipClassifyPreviousCameraW:
         mulw.xyzw     VF26, VF18, VF00w                            NOP
         addw.z        VF26, VF00, VF18w                            NOP
         NOP                                                        loi 0x3727c5ac
         subi.z        VF26, VF26, I                                NOP
         subi.z        VF26, VF26, I                                NOP
         NOP                                                        fcset 0
         clipw.xyz     VF26xyz, VF26w                               NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        fcand VI01, 32
         NOP                                                        b texturedClipPreviousMembershipCaptured
         NOP                                                        NOP
texturedClipClassifyPreviousNearZ:
         mulw.xyzw     VF26, VF18, VF00w                            NOP
         NOP                                                        loi 0x3727c5ac
         subi.z        VF26, VF26, I                                NOP
         addz.z        VF26, VF26, VF26z                            NOP
         subw.z        VF26, VF26, VF18w                            NOP
         NOP                                                        fcset 0
         clipw.xyz     VF26xyz, VF26w                               NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        fcand VI01, 32
         NOP                                                        b texturedClipPreviousMembershipCaptured
         NOP                                                        NOP
texturedClipClassifyPreviousLeft:
         NOP                                                        fcset 0
         clipw.xyz     VF18xyz, VF18w                               NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        fcand VI01, 2
         NOP                                                        b texturedClipPreviousMembershipCaptured
         NOP                                                        NOP
texturedClipClassifyPreviousRight:
         NOP                                                        fcset 0
         clipw.xyz     VF18xyz, VF18w                               NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        fcand VI01, 1
         NOP                                                        b texturedClipPreviousMembershipCaptured
         NOP                                                        NOP
texturedClipClassifyPreviousBottom:
         NOP                                                        fcset 0
         clipw.xyz     VF18xyz, VF18w                               NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        fcand VI01, 8
         NOP                                                        b texturedClipPreviousMembershipCaptured
         NOP                                                        NOP
texturedClipClassifyPreviousTop:
         NOP                                                        fcset 0
         clipw.xyz     VF18xyz, VF18w                               NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        fcand VI01, 4
texturedClipPreviousMembershipCaptured:
         NOP                                                        ibeq VI01, VI00, texturedClipPreviousInside
         NOP                                                        NOP
         NOP                                                        iaddiu VI07, VI00, 0x00000000
         NOP                                                        b texturedClipPreviousDistance
         NOP                                                        NOP
texturedClipPreviousInside:
         NOP                                                        iaddiu VI07, VI00, 0x00000001
texturedClipPreviousDistance:
         NOP                                                        iaddiu VI03, VI00, 0x00000000
         NOP                                                        ibeq VI09, VI03, texturedClipDistanceCameraW
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000001
         NOP                                                        ibeq VI09, VI03, texturedClipDistanceNearZ
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000002
         NOP                                                        ibeq VI09, VI03, texturedClipDistanceLeft
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000003
         NOP                                                        ibeq VI09, VI03, texturedClipDistanceRight
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000004
         NOP                                                        ibeq VI09, VI03, texturedClipDistanceBottom
         NOP                                                        NOP
         NOP                                                        b texturedClipDistanceTop
         NOP                                                        NOP
texturedClipDistanceCameraW:
         addw.x        VF24, VF00, VF18w                            NOP
         NOP                                                        loi 0x3727c5ac
         subi.x        VF24, VF24, I                                NOP
         NOP                                                        b texturedClipPreviousDistanceReady
         NOP                                                        NOP
texturedClipDistanceNearZ:
         addz.x        VF24, VF00, VF18z                            NOP
         NOP                                                        loi 0x3727c5ac
         subi.x        VF24, VF24, I                                NOP
         NOP                                                        b texturedClipPreviousDistanceReady
         NOP                                                        NOP
texturedClipDistanceLeft:
         addw.x        VF24, VF18, VF18w                            NOP
         NOP                                                        b texturedClipPreviousDistanceReady
         NOP                                                        NOP
texturedClipDistanceRight:
         sub.x         VF24, VF00, VF18                             NOP
         addw.x        VF24, VF24, VF18w                            NOP
         NOP                                                        b texturedClipPreviousDistanceReady
         NOP                                                        NOP
texturedClipDistanceBottom:
         addy.x        VF24, VF00, VF18y                            NOP
         addw.x        VF24, VF24, VF18w                            NOP
         NOP                                                        b texturedClipPreviousDistanceReady
         NOP                                                        NOP
texturedClipDistanceTop:
         suby.x        VF24, VF00, VF18y                            NOP
         addw.x        VF24, VF24, VF18w                            NOP
texturedClipPreviousDistanceReady:
         NOP                                                        iadd VI14, VI13, VI00
texturedClipPolygonEdgeLoop:
         NOP                                                        lq VF19, 0(VI12)
         NOP                                                        lq VF22, 1(VI12)
         NOP                                                        iaddiu VI03, VI00, 0x00000000
         NOP                                                        ibeq VI09, VI03, texturedClipClassifyCurrentCameraW
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000001
         NOP                                                        ibeq VI09, VI03, texturedClipClassifyCurrentNearZ
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000002
         NOP                                                        ibeq VI09, VI03, texturedClipClassifyCurrentLeft
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000003
         NOP                                                        ibeq VI09, VI03, texturedClipClassifyCurrentRight
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000004
         NOP                                                        ibeq VI09, VI03, texturedClipClassifyCurrentBottom
         NOP                                                        NOP
         NOP                                                        b texturedClipClassifyCurrentTop
         NOP                                                        NOP
texturedClipClassifyCurrentCameraW:
         mulw.xyzw     VF26, VF19, VF00w                            NOP
         addw.z        VF26, VF00, VF19w                            NOP
         NOP                                                        loi 0x3727c5ac
         subi.z        VF26, VF26, I                                NOP
         subi.z        VF26, VF26, I                                NOP
         NOP                                                        fcset 0
         clipw.xyz     VF26xyz, VF26w                               NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        fcand VI01, 32
         NOP                                                        b texturedClipCurrentMembershipCaptured
         NOP                                                        NOP
texturedClipClassifyCurrentNearZ:
         mulw.xyzw     VF26, VF19, VF00w                            NOP
         NOP                                                        loi 0x3727c5ac
         subi.z        VF26, VF26, I                                NOP
         addz.z        VF26, VF26, VF26z                            NOP
         subw.z        VF26, VF26, VF19w                            NOP
         NOP                                                        fcset 0
         clipw.xyz     VF26xyz, VF26w                               NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
