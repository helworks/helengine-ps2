texturedClipCurrentDistanceReady:
         NOP                                                        ilw.y VI01, 0x0000004e(VI00)
         NOP                                                        NOP
         NOP                                                        ibeq VI07, VI01, texturedClipPolygonNoIntersection
         NOP                                                        NOP
