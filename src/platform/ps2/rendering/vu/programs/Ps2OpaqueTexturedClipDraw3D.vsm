         NOP                                                        iaddiu VI11, VI11, 0x00000001
texturedClipPolygonNoIntersection:
         NOP                                                        ibeq VI01, VI00, texturedClipPolygonAdvanceEdge
         NOP                                                        NOP
         NOP                                                        iaddiu VI03, VI00, 0x00000009
         NOP                                                        ibeq VI11, VI03, texturedClipPolygonOverflow
         NOP                                                        NOP
         NOP                                                        sq VF19, 0(VI10)
         NOP                                                        sq VF22, 1(VI10)
         NOP                                                        iaddiu VI10, VI10, 0x00000002
         NOP                                                        iaddiu VI11, VI11, 0x00000001
texturedClipPolygonAdvanceEdge:
         mulw.xyzw     VF18, VF19, VF00w                            NOP
         mulw.xyzw     VF21, VF22, VF00w                            NOP
         mulw.x        VF24, VF25, VF00w                            NOP
         NOP                                                        iadd VI07, VI01, VI00
         NOP                                                        iaddiu VI12, VI12, 0x00000002
         NOP                                                        isubiu VI14, VI14, 0x00000001
         NOP                                                        ibne VI14, VI00, texturedClipPolygonEdgeLoop
         NOP                                                        NOP
         NOP                                                        iadd VI13, VI11, VI00
         NOP                                                        iadd VI12, VI04, VI00
         NOP                                                        iaddiu VI04, VI00, 0x00000100
         NOP                                                        jr VI02
         NOP                                                        NOP
texturedClipPolygonOverflow:
         NOP                                                        iaddiu VI01, VI00, 0x00000001
         NOP                                                        isw.x VI01, 0x0000004d(VI00)
         NOP                                                        iaddiu VI13, VI00, 0x00000000
         NOP                                                        iaddiu VI04, VI00, 0x00000100
         NOP                                                        jr VI02
         NOP                                                        NOP

; Projects and conditionally compacts one already-clipped triangle.
; Input: VF18-20 clip positions, VF21-23 raw UV, VF17 lit colour.
texturedClipEmitTriangle:
texturedClipValidateTriangleA:
         NOP                                                        loi 0x3727c5ac
         addw.x        VF24, VF00, VF18w                            NOP
         subi.x        VF24, VF24, I                                NOP
