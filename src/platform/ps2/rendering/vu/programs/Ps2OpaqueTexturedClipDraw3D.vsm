         suby.x        VF25, VF00, VF18y                            NOP
         addw.x        VF25, VF25, VF18w                            NOP
         minix.x       VF24, VF24, VF25x                            NOP
         subi.z        VF25, VF18, I                                NOP
         miniz.x       VF24, VF24, VF25z                            NOP
