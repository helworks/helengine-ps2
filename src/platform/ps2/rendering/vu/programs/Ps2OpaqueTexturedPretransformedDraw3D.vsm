; Pretransformed textured opaque VU1 microprogram.
; The EE retains the 21-qword textured shared state and provides seven-qword
; homogeneous clip-space triangle records beginning at XTOP + 0x15.

		.vu
		.align 4
		.global	Ps2OpaqueTexturedPretransformedDraw3D_CodeStart
		.global	Ps2OpaqueTexturedPretransformedDraw3D_CodeEnd
Ps2OpaqueTexturedPretransformedDraw3D_CodeStart:
__ps2_opaque_textured_pretransformed_draw_3d:
         NOP                                                        xtop VI02
         NOP                                                        lq VF05, 4(VI02)
         NOP                                                        lq VF06, 5(VI02)
         NOP                                                        lq VF07, 6(VI02)
         NOP                                                        ilw.x VI01, 7(VI02)
         NOP                                                        ilw.y VI08, 7(VI02)
         NOP                                                        lq VF11, 8(VI02)
         NOP                                                        lq VF12, 9(VI02)
         NOP                                                        lq VF13, 10(VI02)
         NOP                                                        lq VF14, 12(VI02)
         NOP                                                        iaddiu VI03, VI00, 0x00000100
         NOP                                                        iaddiu VI04, VI03, 0x00000000
         NOP                                                        iaddiu VI05, VI02, 0x00000015
         NOP                                                        iaddiu VI06, VI00, 0x00000000
         NOP                                                        iaddiu VI09, VI00, 0x00007fff
         NOP                                                        iaddiu VI09, VI09, 0x00000001
         NOP                                                        lq VF08, 13(VI02)
         NOP                                                        sq VF08, 0(VI03)
         NOP                                                        lq VF08, 14(VI02)
         NOP                                                        sq VF08, 1(VI03)
         NOP                                                        lq VF08, 15(VI02)
         NOP                                                        sq VF08, 2(VI03)
         NOP                                                        lq VF08, 16(VI02)
         NOP                                                        sq VF08, 3(VI03)
         NOP                                                        lq VF08, 17(VI02)
         NOP                                                        sq VF08, 4(VI03)
         NOP                                                        lq VF08, 18(VI02)
         NOP                                                        sq VF08, 5(VI03)
         NOP                                                        lq VF08, 19(VI02)
         NOP                                                        sq VF08, 6(VI03)
         NOP                                                        lq VF08, 20(VI02)
         NOP                                                        sq VF08, 7(VI03)
         NOP                                                        iaddiu VI03, VI03, 0x00000008
texturedPretransformedTriangleLoop:
         NOP                                                        lq VF08, 0(VI05)
         NOP                                                        lq VF09, 3(VI05)
         NOP                                                        lq VF10, 6(VI05)
         mulax         ACC, VF11, VF10x                              NOP
         madday        ACC, VF12, VF10y                              NOP
         maddz.xyz     VF15, VF13, VF10z                             NOP
         mul.xyz       VF16, VF15, VF15                              NOP
         addy.x        VF16, VF16, VF16y                             NOP
         addz.x        VF16, VF16, VF16z                             NOP
         NOP                                                        ersqrt        P, VF16x
         NOP                                                        waitp
         NOP                                                        mfp.w         VF16, P
         mulw.xyz      VF15, VF15, VF16w                             NOP
         mul.xyz       VF16, VF15, VF14                              NOP
         addy.x        VF16, VF16, VF16y                             NOP
         addz.x        VF16, VF16, VF16z                             NOP
         maxx.x        VF16, VF16, VF00x                             NOP
         mulw.x        VF16, VF16, VF07w                             NOP
         NOP                                                        loi           0x433f0000
         muli.x        VF16, VF16, I                                 NOP
         NOP                                                        loi           0x42800000
         addi.x        VF16, VF16, I                                 NOP
         mulw.w        VF17, VF00, VF10w                             NOP
         mulx.xyz      VF17, VF07, VF16x                             NOP
         ftoi0         VF17, VF17                                    NOP
         NOP                                                        div           Q, VF00w, VF08w
         mulq.xy       VF09, VF09, Q                                waitq
         addq.z        VF09, VF00, Q                                NOP
         addq.w        VF17, VF00, Q                                NOP
         mulq.xyz      VF08, VF08, Q                                NOP
         add.xy        VF18, VF08, VF00                              NOP
         mul.xyz       VF08, VF08, VF05                             NOP
         add.xyz       VF08, VF08, VF06                             NOP
         ftoi4.xy      VF08, VF08                                   NOP
         ftoi0.z       VF08, VF08                                   NOP
         NOP                                                        sq VF09, 0(VI03)
         NOP                                                        sq VF17, 1(VI03)
         NOP                                                        sq VF08, 2(VI03)
         NOP                                                        isw.w VI06, 2(VI03)
         NOP                                                        lq VF08, 1(VI05)
         NOP                                                        lq VF09, 4(VI05)
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        div           Q, VF00w, VF08w
         mulq.xy       VF09, VF09, Q                                waitq
         addq.z        VF09, VF00, Q                                NOP
         addq.w        VF17, VF00, Q                                NOP
         mulq.xyz      VF08, VF08, Q                                NOP
         add.xy        VF19, VF08, VF00                              NOP
         mul.xyz       VF08, VF08, VF05                             NOP
         add.xyz       VF08, VF08, VF06                             NOP
         ftoi4.xy      VF08, VF08                                   NOP
         ftoi0.z       VF08, VF08                                   NOP
         NOP                                                        sq VF09, 3(VI03)
         NOP                                                        sq VF17, 4(VI03)
         NOP                                                        sq VF08, 5(VI03)
         NOP                                                        isw.w VI06, 5(VI03)
         NOP                                                        lq VF08, 2(VI05)
         NOP                                                        lq VF09, 5(VI05)
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        div           Q, VF00w, VF08w
         mulq.xy       VF09, VF09, Q                                waitq
         addq.z        VF09, VF00, Q                                NOP
         addq.w        VF17, VF00, Q                                NOP
         mulq.xyz      VF08, VF08, Q                                NOP
         add.xy        VF20, VF08, VF00                              NOP
         mul.xyz       VF08, VF08, VF05                             NOP
         add.xyz       VF08, VF08, VF06                             NOP
         ftoi4.xy      VF08, VF08                                   NOP
         ftoi0.z       VF08, VF08                                   NOP
         NOP                                                        sq VF09, 6(VI03)
         NOP                                                        sq VF17, 7(VI03)
         NOP                                                        sq VF08, 8(VI03)
         NOP                                                        isw.w VI06, 8(VI03)
         NOP                                                        ibne VI08, VI00, texturedPretransformedTriangleAccepted
         NOP                                                        NOP
         sub.xy        VF21, VF19, VF18                              NOP
         sub.xy        VF22, VF20, VF18                              NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         opmula.xyz    ACC, VF21xyz, VF22xyz                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         opmsub.xyz    VF23xyz, VF22xyz, VF21xyz                    NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         ftoi12.z     VF23, VF23                                    NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        mtir VI07, VF23z
         NOP                                                        NOP
         NOP                                                        NOP
         NOP                                                        ibgez VI07, texturedPretransformedTriangleAccepted
         NOP                                                        NOP
         NOP                                                        b texturedPretransformedTriangleLoopTail
         NOP                                                        NOP
texturedPretransformedTriangleAccepted:
         NOP                                                        iaddiu VI03, VI03, 0x00000009
         NOP                                                        iaddiu VI06, VI06, 0x00000001
texturedPretransformedTriangleLoopTail:
         NOP                                                        iaddiu VI05, VI05, 0x00000007
         NOP                                                        isubiu VI01, VI01, 0x00000001
         NOP                                                        ibne VI01, VI00, texturedPretransformedTriangleLoop
         NOP                                                        NOP
         NOP                                                        ibeq VI06, VI00, texturedPretransformedDrawComplete
         NOP                                                        NOP
         NOP                                                        iadd VI07, VI06, VI06
         NOP                                                        iadd VI07, VI07, VI06
         NOP                                                        iadd VI07, VI07, VI09
         NOP                                                        isw.x VI07, 7(VI04)
         NOP                                                        xgkick VI04
texturedPretransformedDrawComplete:
         NOP[E]                                                     NOP
         NOP                                                        NOP
		.align 4
Ps2OpaqueTexturedPretransformedDraw3D_CodeEnd:
