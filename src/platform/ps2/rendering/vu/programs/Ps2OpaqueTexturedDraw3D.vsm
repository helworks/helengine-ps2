         NOP                                                        lq VF08, 20(VI02)
         NOP                                                        sq VF08, 7(VI03)
         NOP                                                        iaddiu VI03, VI03, 0x00000008
texturedTriangleLoop:
         NOP                                                        lq VF08, 0(VI05)
         NOP                                                        lq VF09, 3(VI05)
         NOP                                                        lq VF10, 6(VI05)
